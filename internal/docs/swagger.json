                "payment_method_id"
            ],
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "note": {
                    "type": "string"
                },
                "payment_method_id": {
                    "type": "integer"
                }
            }
        },
        "dto.CreateTransferRequest": {
            "type": "object",
            "required": [
                "amount",
                "pin",
                "receiver_id"
            ],
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "note": {
                    "type": "string"
                },
                "pin": {
                    "type": "string"
                },
